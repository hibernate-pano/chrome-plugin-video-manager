{
  "compilerOptions": {
    // 基础选项
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    // 模块解析
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    // 路径别名
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components": ["./shared/components"],
      "@/components/*": ["./shared/components/*"],
      "@/lib": ["./shared/lib"],
      "@/lib/*": ["./shared/lib/*"],
      "@/hooks": ["./shared/hooks"],
      "@/hooks/*": ["./shared/hooks/*"],
      "@/options/*": ["./options/*"],
      "@/content/*": ["./content/*"],
      "@/shared/*": ["./shared/*"],
      "@/background/*": ["./background/*"]
    },

    // 严格类型检查
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "options/**/*",
    "content/**/*",
    "shared/**/*",
    "background/**/*",
    "vite.config.ts",
    "vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.tsx",
    "**/*.stories.ts",
    ".storybook/**/*"
  ]
}
