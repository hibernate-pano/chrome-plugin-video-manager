{
  "name": "video-speed-controller",
  "version": "5.2.1",
  "description": "Chrome extension for controlling video playback speed with keyboard shortcuts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/copy-assets.js",
    "build:ext": "pnpm build && node scripts/package-extension.js",
    "package:ext": "node scripts/package-extension.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/chrome": "^0.1.37",
    "jsdom": "^24.1.3",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
