{
  "name": "video-audio-speed-controller",
  "version": "3.3.0",
  "description": "Chrome extension for controlling video and audio playback speed with keyboard shortcuts",
  "type": "module",
  "main": "content.js",
  "scripts": {
    "build": "npm run build:ts && node scripts/build.js",
    "build:ts": "tsc --noEmit",
    "build:prod": "NODE_ENV=production node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "node scripts/clean.js",
    "dev": "npm run clean && npm run build && npm run watch",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts,json,css,html}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "chrome-extension",
    "video-speed",
    "audio-speed",
    "playback-control",
    "keyboard-shortcuts"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.29.0",
    "@playwright/test": "^1.58.2",
    "@types/chrome": "^0.0.258",
    "babel-jest": "^30.2.0",
    "esbuild": "^0.19.5",
    "eslint": "^8.52.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "terser": "^5.46.0",
    "typescript": "^5.3.0"
  }
}
