{
  "name": "video-audio-speed-controller",
  "version": "2.0.0",
  "description": "Chrome extension for controlling video and audio playback speed with keyboard shortcuts",
  "main": "content.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "node scripts/clean.js",
    "dev": "npm run clean && npm run build && npm run watch"
  },
  "keywords": [
    "chrome-extension",
    "video-speed",
    "audio-speed",
    "playback-control",
    "keyboard-shortcuts"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "esbuild": "^0.19.5",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
