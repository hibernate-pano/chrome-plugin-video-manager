{
  "manifest_version": 3,
  "name": "Video Speed Controller",
  "version": "4.0.1",
  "description": "Control video playback speed with keyboard shortcuts - Cyberpunk Edition",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Video Speed Controller"
  },
  "background": {
    "service_worker": "src/background.ts"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.tsx"],
      "run_at": "document_end"
    }
  ],
  "options_page": "options.html"
}
