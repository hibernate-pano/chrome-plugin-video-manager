{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.4",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "action": {
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "css": ["style.css"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ]
}
