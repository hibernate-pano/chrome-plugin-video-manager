{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "Video Speed Controller — Fullscreen & Keys",
  "version": "6.1.0",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "chunks/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Video Speed Controller — Fullscreen & Keys",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "open-options": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma"
      },
      "description": "__MSG_commandOpenOptions__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-loader.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/hibernate-pano/chrome-plugin-video-manager"
}
