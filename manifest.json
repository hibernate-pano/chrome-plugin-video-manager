{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "Video Speed Controller",
  "version": "1.5.2",
  "description": "Minimal video speed shortcuts and page fullscreen for HTML5 video",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["content.js", "chunks/*.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Video Speed Controller"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-loader.js"],
      "run_at": "document_end"
    }
  ],
  "options_page": "options.html"
}
